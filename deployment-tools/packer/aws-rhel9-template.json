{
  "variables": {
    "variant": "mini",
    "_comment": "The following variants are supported: mini, fs, sip, rtp, sip-rtp, web, monitoring, web-monitoring, recording",
    "region": "us-east-1",
    "ssh_username": "ec2-user",
    "ami_description": "jambonz all-in-one AMI", 
    "instance_type": "c6in.2xlarge",
    "drachtio_version": "v0.9.3",
    "jambonz_version": "v0.9.5-2",
    "jambonz_user": "admin",
    "jambonz_password": "JambonzR0ck$",
    "ami_base_image_owner": "309956199498",
    "install_telegraf": "yes",
    "telegraf_role": "mini",
    "homer_user": "homer_user",
    "homer_password": "XcapJTqy11LnsYRtxXGPTYQkAnI",
    "install_influxdb":  "yes",
    "install_grafana":  "yes",
    "install_homer":  "yes",
    "install_jaeger":  "yes",
    "install_cloudwatch":  "yes",
    "install_nodered":  "no",
    "install_certbot.sh": "yes",
    "influxdb_ip":  "127.0.0.1",
    "rtp_engine_version": "mr11.5.1.45",
    "rtp_engine_min_port": "40000",
    "rtp_engine_max_port": "60000",
    "mediaserver_name" : "jambonz",
    "preferred_codec_list" : "PCMU,PCMA,OPUS,G722",
    "distro": "rhel-9",
    "ami_base_image_arch": "amd64",
    "leave_source": "no",
    "encrypt_boot": "false",
    "kms_key_id": ""
  },
  "builders": [{
    "type": "amazon-ebs",
    "region": "{{user `region`}}",
    "source_ami_filter": {
      "filters": {
        "virtualization-type": "hvm",
        "name": "RHEL-9.5.0*",
        "root-device-type": "ebs",
        "architecture": "x86_64"
      },
      "owners": ["{{user `ami_base_image_owner`}}"],
      "most_recent": true
    },
    "instance_type": "{{user `instance_type`}}",
    "ssh_username": "{{user `ssh_username`}}",
    "ami_name": "jambonz-{{user `variant`}}-{{user `jambonz_version`}}-{{user `distro`}}-{{isotime |clean_resource_name }}",
    "ami_description": "{{user `ami_description`}}",
    "launch_block_device_mappings": [
      {
        "device_name": "/dev/sda1",
        "volume_size": 100,
        "volume_type": "gp3",
        "delete_on_termination": true,
        "encrypted": "{{user `encrypt_boot`}}",
        "kms_key_id": "{{user `kms_key_id`}}"
      }
    ],
    "tags": {
      "Name": "jambonz-mini"
    },
    "run_tags": {
      "Name": "jambonz-mini-build"
    }
  }],
  "provisioners": [
    {
      "type": "shell",
      "inline": [
        "while [ ! -f /var/lib/cloud/instance/boot-finished ]; do echo 'Waiting for cloud-init...'; sleep 1; done",
        "export PATH=/usr/local/bin:$PATH",
        "export LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH",
        "export PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:$PKG_CONFIG_PATH",
        "sudo setenforce 0",
        "sudo sed -i 's/SELINUX=enforcing/SELINUX=disabled/' /etc/selinux/config",
        "sudo dnf upgrade --exclude=kernel* -y",
        "sudo sed -i 's/manage_repos = 0/manage_repos = 1/' /etc/rhsm/rhsm.conf",
        "sudo dnf config-manager --set-enabled codeready-builder-for-rhel-9-rhui-rpms",
        "sudo dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm",
        "sudo dnf install -y https://download1.rpmfusion.org/free/el/rpmfusion-free-release-9.noarch.rpm",
        "sudo dnf groupinstall -y 'RPM Development Tools'",
        "sudo dnf groupinstall -y 'Development Tools'",
        "sudo dnf install -y cmake cronie nc iptables-devel htop pandoc wget ffmpeg ffmpeg-devel fail2ban boost-devel \\",
        "perl-IPC-Cmd pcre-devel google-perftools-devel libcurl-devel curl jq telnet php php-devel libev-devel \\",
        "libevent-devel xmlrpc-c-devel gperf libpcap-devel glib2-devel json-glib-devel libmnl-devel libnftnl-devel \\",
        "hiredis-devel spandsp-devel mariadb-devel dnsutils speex bc libedit-devel python3-setuptools python3-devel \\",
        "opus-devel lsof redis yasm perl-ExtUtils-Embed libmpg123-devel libshout-devel \\",
        "systemd-devel speex-devel speexdsp-devel re2-devel opusfile-devel libtiff-devel \\",
        "snapd libjpeg-devel libsndfile-devel lua-devel sqlite-devel libuuid-devel alsa-lib \\",
        "lame-devel libyuv-devel protobuf-compiler tcpdump kernel-headers-$(uname -r) kernel-devel-$(uname -r)",
        "sudo dnf debuginfo-install -y binutils",
        "sudo chmod a+w /usr/local/src"
      ]
    },
    {
      "type": "file",
      "source": "files/",
      "destination": "/tmp"
    },
    {
      "type": "shell",
      "inline": [
        "sudo cp /tmp/get-aws-metadata.sh /usr/local/bin",
        "sudo chmod +x /usr/local/bin/get-aws-metadata.sh"
      ]
    },
    {
      "type": "shell",
      "execute_command": "chmod +x {{ .Path }}; sudo '{{ .Path }}' {{user `variant`}} {{user `distro`}}",
      "script": "scripts/install_os_tuning.sh"
    },
    {
      "type": "shell",
      "execute_command": "chmod +x {{ .Path }}; sudo '{{ .Path }}'  {{user `variant`}} {{user `distro`}} {{user `ami_base_image_arch`}}",
      "script": "scripts/install_cmake.sh"
    },
    {
      "type": "shell",
      "execute_command": "chmod +x {{ .Path }}; sudo '{{ .Path }}'  {{user `variant`}} {{user `distro`}}",
      "script": "scripts/install_autoconf.sh"
    },
    {
      "type": "shell",
      "execute_command": "chmod +x {{ .Path }}; sudo '{{ .Path }}'  {{user `variant`}} {{user `distro`}}",
      "script": "scripts/install_nodejs.sh"
    },
    {
      "type": "shell",
      "execute_command": "chmod +x {{ .Path }}; sudo '{{ .Path }}' {{user `variant`}} {{user `distro`}} {{user `preferred_codec_list`}} {{user `mediaserver_name`}} {{user `ami_base_image_arch`}}",
      "script": "scripts/install_freeswitch.sh"
    },
    {
      "type": "shell",
      "execute_command": "chmod +x {{ .Path }}; sudo '{{ .Path }}'  {{user `variant`}} {{user `distro`}}",
      "script": "scripts/install_recordings_uploader.sh"
    },
    {
      "type": "shell",
      "execute_command": "chmod +x {{ .Path }}; sudo '{{ .Path }}'  {{user `variant`}} {{user `distro`}}",
      "script": "scripts/install_jaeger.sh"
    },
    {
      "type": "shell",
      "execute_command": "chmod +x {{ .Path }}; sudo '{{ .Path }}'  {{user `variant`}} {{user `distro`}} {{user `rtp_engine_version`}}",
      "script": "scripts/install_rtpengine.sh"
    },
    {
      "type": "shell",
      "execute_command": "chmod +x {{ .Path }}; sudo '{{ .Path }}'  {{user `variant`}} {{user `distro`}} {{user `jambonz_version`}} {{user `jambonz_user`}} {{user `jambonz_password`}}",
      "script": "scripts/install_jambonz_apps.sh"
    },
    {
      "type": "shell",
      "execute_command": "chmod +x {{ .Path }}; sudo '{{ .Path }}'  {{user `variant`}} {{user `distro`}}",
      "script": "scripts/install_redis.sh"
    },
    {
      "type": "shell",
      "execute_command": "chmod +x {{ .Path }}; sudo '{{ .Path }}'   {{user `variant`}} {{user `distro`}} {{user `jambonz_user`}} {{user `jambonz_password`}}",
      "script": "scripts/install_mysql.sh"
    },
    {
      "type": "shell",
      "execute_command": "chmod +x {{ .Path }}; sudo '{{ .Path }}' {{user `variant`}} {{user `distro`}}",
      "script": "scripts/install_telegraf.sh"
    },
    {
      "type": "shell",
      "execute_command": "chmod +x {{ .Path }}; sudo '{{ .Path }}'  {{user `variant`}} {{user `distro`}} {{user `homer_user`}} {{user `homer_password`}}",
      "script": "scripts/install_postgresql.sh"
    },
    {
      "type": "shell",
      "execute_command": "chmod +x {{ .Path }}; sudo '{{ .Path }}'  {{user `variant`}} {{user `distro`}} {{user `homer_user`}} {{user `homer_password`}}",
      "script": "scripts/install_homer.sh"
    },
    {
      "type": "shell",
      "execute_command": "chmod +x {{ .Path }}; sudo '{{ .Path }}'  {{user `variant`}} {{user `distro`}}",
      "script": "scripts/install_influxdb.sh"
    },
    {
      "type": "shell",
      "execute_command": "chmod +x {{ .Path }}; sudo '{{ .Path }}' {{user `variant`}} {{user `distro`}}",
      "script": "scripts/install_nginx.sh"
    },
    {
      "type": "shell",
      "execute_command": "chmod +x {{ .Path }}; sudo '{{ .Path }}'  {{user `variant`}} {{user `distro`}} {{user `telegraf_role`}}",
      "script": "scripts/install_grafana.sh"
    },
    {
      "type": "shell",
      "execute_command": "chmod +x {{ .Path }}; sudo '{{ .Path }}'  {{user `variant`}} {{user `distro`}} {{user `install_certbot.sh`}}",
      "script": "scripts/install_certbot.sh"
    },
    {
      "type": "shell",
      "execute_command": "chmod +x {{ .Path }}; sudo '{{ .Path }}'  {{user `variant`}} {{build `ID`}} {{user `apiban_username`}} {{user `apiban_password`}}",
      "script": "scripts/install_apiban.sh"
    },
    {
      "type": "shell",
      "execute_command": "chmod +x {{ .Path }}; sudo '{{ .Path }}' {{user `variant`}} {{user `distro`}}",
      "script": "scripts/install_fail2ban.sh"
    },
    {
      "type": "shell",
      "execute_command": "chmod +x {{ .Path }}; sudo '{{ .Path }}'  {{user `variant`}} {{user `distro`}} {{user `ami_base_image_arch`}}",
      "script": "scripts/install_cloudwatch.sh"
    },
    {
      "type": "shell",
      "execute_command": "chmod +x {{ .Path }}; sudo '{{ .Path }}'  {{user `variant`}} {{user `distro`}} {{user `drachtio_version`}}",
      "script": "scripts/install_drachtio.sh"
    },
    {
      "type": "shell",
      "execute_command": "chmod +x {{ .Path }}; sudo '{{ .Path }}'  {{user `variant`}} {{user `distro`}} {{user `install_jambonz_team_keys`}}",
      "script": "scripts/install_ssh_keys.sh"
    },
    {
      "type": "shell",
      "execute_command": "chmod +x {{ .Path }}; sudo '{{ .Path }}' {{user `variant`}} {{user `distro`}} {{user `leave_source`}}",
      "script": "scripts/cleanup.sh"
    }
  ]
}

