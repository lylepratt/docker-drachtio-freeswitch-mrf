@@ -0,0 +1,48 @@
+#ifndef GPTLIVE_OUTPUT_ACTIVITY_HPP
+#define GPTLIVE_OUTPUT_ACTIVITY_HPP
+
+#include <cstddef>
+#include <cstdint>
+
+namespace gptlive_s2s {
+// Observes output PCM only; it never removes, gates, or modifies playback audio.
+// A short quiet hold avoids reporting every gap between words as a stop.
+// Production probe: silent transient peaked at 46, speech onset at 111.
+// Peak 100 separates those observations; it is not semantic turn detection.
+class OutputActivity {
+public:
+  bool active;
+  uint64_t quiet_us;
+
+  OutputActivity(bool active = false, uint64_t quiet_us = 0)
+    : active(active), quiet_us(quiet_us) {}
+
+  int update(const int16_t* pcm, size_t samples, unsigned int rate) {
+    if (!rate || !samples) return 0;
+    bool audible = false;
+    if (pcm) {
+      for (size_t i = 0; i < samples; ++i) {
+        const int value = pcm[i];
+        if (value > 100 || value < -100) {
+          audible = true;
+          break;
+        }
+      }
+    }
+    if (audible) {
+      quiet_us = 0;
+      if (active) return 0;
+      active = true;
+      return 1;
+    }
+    if (!active) return 0;
+    quiet_us += static_cast<uint64_t>(samples) * 1000000 / rate;
+    if (quiet_us < 200000) return 0;
+    active = false;
+    quiet_us = 0;
+    return -1;
+  }
+};
+}
+
+#endif
